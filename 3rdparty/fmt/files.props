<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	<LibFmtFilesDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</LibFmtFilesDir>
  </PropertyGroup>
  
  <ItemGroup>
    <ClCompile Include="$(LibFmtFilesDir)\src\format.cc"/>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(LibFmtFilesDir)\include\fmt\format.h" />
  </ItemGroup>
</Project>