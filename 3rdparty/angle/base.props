<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	<AngleDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\angle'))</AngleDir>
  </PropertyGroup>
  
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
	<ClCompile>
      <PreprocessorDefinitions>EGLAPI=;EGLAPIENTRY=;GL_APICALL=;GL_APIENTRY=;ANGLE_APIENTRY=;ANGLE_EXPORT=;ANGLE_PLATFORM_EXPORT=;ANGLE_STANDALONE_BUILD;GL_GLEXT_PROTOTYPES;EGL_EGLEXT_PROTOTYPES;ANGLE_X64_CPU;_HAS_EXCEPTIONS=0;_ITERATOR_DEBUG_LEVEL=0;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
	  <AdditionalIncludeDirectories>$(AngleDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>