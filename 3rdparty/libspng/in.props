<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="base.props" />

  <PropertyGroup>
    <LibMinizDir>$(LibSPNGDir)subprojects\miniz-2.2.0</LibMinizDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LibMinizDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="$(LibMinizDir)\miniz.c"/>
    <ClCompile Include="$(LibSPNGSrcDir)\spng.c"/>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(LibMinizDir)\miniz.h"/>
    <ClInclude Include="$(LibSPNGSrcDir)\spng.h" />
  </ItemGroup>
</Project>