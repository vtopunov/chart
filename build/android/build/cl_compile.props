<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">  
  <Import Project="cl_compile_c.props" />
  
  <ItemDefinitionGroup>
    <ClCompile>
      <CppLanguageStandard>c++1z</CppLanguageStandard>
      <AdditionalOptions>-std=c++2a -Wno-braced-scalar-init -Wno-missing-braces %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>